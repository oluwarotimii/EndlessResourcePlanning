{
  "name": "aura",
  "label": "AURA (Apple-style)",
  "primitive": {
    "blue": "#0066CC", "sky": "#5AC8FA", "ink": "#1D1D1F", "cloud": "#F5F5F7", "mist": "#86868B",
    "white": "#FFFFFF", "black": "#000000", "graphite": "#1C1C1E", "slate": "#2C2C2E", "night": "#121214"
  },
  "semantic": {
    "light": {
      "primary": "{blue}", "primary-ink": "#0066CC",
      "secondary": "{sky}", "secondary-ink": "#00678F",
      "surface": "rgba(255, 255, 255, 0.85)", "surface-raised": "{white}", "surface-overlay": "rgba(245, 245, 247, 0.95)",
      "border": "rgba(0, 0, 0, 0.08)", "border-strong": "rgba(0, 0, 0, 0.16)",
      "text": "{ink}", "text-muted": "#6E6E73",
      "fill": "rgba(0, 0, 0, 0.05)", "fill-hover": "rgba(0, 0, 0, 0.09)",
      "bg-start": "{cloud}", "bg-end": "#E8E8ED", "scrim": "rgba(0, 0, 0, 0.4)",
      "success": "#34C759", "success-ink": "#1A7F37",
      "warning": "#FF9500", "warning-ink": "#8A5A00",
      "danger": "#FF3B30", "danger-ink": "#C62828",
      "info": "#0A84FF", "info-ink": "#0062CC",
      "shadow-card": "0 4px 20px -2px rgba(0, 0, 0, 0.05)", "shadow-lift": "0 10px 30px -4px rgba(0, 0, 0, 0.1)"
    },
    "dark": {
      "primary": "{blue}", "primary-ink": "#4DA3FF",
      "secondary": "{sky}", "secondary-ink": "#5AC8FA",
      "surface": "rgba(28, 28, 30, 0.82)", "surface-raised": "{graphite}", "surface-overlay": "rgba(44, 44, 46, 0.95)",
      "border": "rgba(255, 255, 255, 0.1)", "border-strong": "rgba(255, 255, 255, 0.2)",
      "text": "{cloud}", "text-muted": "#A1A1A6",
      "fill": "rgba(255, 255, 255, 0.06)", "fill-hover": "rgba(255, 255, 255, 0.11)",
      "bg-start": "{black}", "bg-end": "{night}", "scrim": "rgba(0, 0, 0, 0.6)",
      "success": "#30D158", "success-ink": "#30D158",
      "warning": "#FF9F0A", "warning-ink": "#FFB340",
      "danger": "#FF453A", "danger-ink": "#FF6B6B",
      "info": "#0A84FF", "info-ink": "#64A8FF",
      "shadow-card": "0 4px 20px -2px rgba(0, 0, 0, 0.4)", "shadow-lift": "0 10px 30px -4px rgba(0, 0, 0, 0.6)"
    }
  },
  "component": {
    "font-sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "radius-sm": "8px", "radius-md": "12px", "radius-lg": "16px", "radius-xl": "20px", "radius-full": "9999px",
    "touch-min": "48px", "touch-till": "56px",
    "glass-blur": "blur(20px) saturate(180%)", "scrim-blur": "blur(4px)",
    "duration-fast": "150ms", "duration-spatial": "300ms",
    "ease-snap": "cubic-bezier(0.25, 1, 0.5, 1)", "ease-spatial": "cubic-bezier(0.16, 1, 0.3, 1)",
    "press-scale": "0.96", "lift-distance": "-2px"
  }
}
