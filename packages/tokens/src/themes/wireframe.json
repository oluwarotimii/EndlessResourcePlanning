{
  "name": "wireframe",
  "label": "Wireframe (neutral throwaway)",
  "primitive": { "ink": "#222222", "paper": "#FFFFFF", "grey": "#EDEDED" },
  "semantic": {
    "light": {
      "primary": "#333333", "primary-ink": "#333333", "secondary": "#9A9A9A", "secondary-ink": "#4A4A4A",
      "surface": "{paper}", "surface-raised": "{paper}", "surface-overlay": "{paper}",
      "border": "#D0D0D0", "border-strong": "#8C8C8C", "text": "{ink}", "text-muted": "#595959",
      "fill": "#F2F2F2", "fill-hover": "#E4E4E4", "bg-start": "{grey}", "bg-end": "{grey}", "scrim": "rgba(0, 0, 0, 0.45)",
      "success": "#4D4D4D", "success-ink": "#2E2E2E", "warning": "#808080", "warning-ink": "#404040",
      "danger": "#000000", "danger-ink": "#000000", "info": "#666666", "info-ink": "#333333",
      "shadow-card": "none", "shadow-lift": "none"
    },
    "dark": {
      "primary": "#EEEEEE", "primary-ink": "#EEEEEE", "secondary": "#8A8A8A", "secondary-ink": "#C8C8C8",
      "surface": "#1A1A1A", "surface-raised": "#242424", "surface-overlay": "#2A2A2A",
      "border": "#3A3A3A", "border-strong": "#6A6A6A", "text": "#F2F2F2", "text-muted": "#A8A8A8",
      "fill": "#2E2E2E", "fill-hover": "#3A3A3A", "bg-start": "#111111", "bg-end": "#111111", "scrim": "rgba(0, 0, 0, 0.6)",
      "success": "#BDBDBD", "success-ink": "#D8D8D8", "warning": "#9E9E9E", "warning-ink": "#C8C8C8",
      "danger": "#FFFFFF", "danger-ink": "#FFFFFF", "info": "#A0A0A0", "info-ink": "#C0C0C0",
      "shadow-card": "none", "shadow-lift": "none"
    }
  },
  "component": {
    "font-sans": "system-ui, sans-serif",
    "radius-sm": "2px", "radius-md": "4px", "radius-lg": "4px", "radius-xl": "6px", "radius-full": "9999px",
    "touch-min": "48px", "touch-till": "56px",
    "glass-blur": "none", "scrim-blur": "none",
    "duration-fast": "0ms", "duration-spatial": "0ms",
    "ease-snap": "linear", "ease-spatial": "linear",
    "press-scale": "1", "lift-distance": "0px"
  }
}
